# Dataset: never versioned, it re-downloads from Roboflow
data/
*.zip

# Heavy weights. Only exported ONNX models are tracked.
*.pt
*.onnx
!models/*.onnx

# Secrets. The Roboflow API key must never reach GitHub.
.env
*.key
secrets*

# Raw training outputs
runs/
drone_bird/
wandb/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# OS
Thumbs.db
desktop.ini
.DS_Store
